# Copie este archivo como .env y ajuste los valores. Nunca suba .env al repositorio.

# Entorno: development | test | production
NODE_ENV=development
PORT=3000
# URL pública (se usa en los enlaces de los correos)
APP_URL=http://localhost:3000

# Base de datos: sqlite (local) | pg (producción)
DB_CLIENT=sqlite
DB_FILENAME=./data/th.sqlite
# Para PostgreSQL:
# DB_CLIENT=pg
# DATABASE_URL=postgres://usuario:clave@localhost:5432/talento_humano

# Clave de 32 bytes en hex para cifrar campos sensibles (diagnósticos, cuentas).
# Obligatoria en producción. En desarrollo, si se deja vacía, se usa una clave fija solo para datos ficticios.
# Genérela con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATA_ENCRYPTION_KEY=

# Módulos activos (separados por coma)
MODULES_ENABLED=auth,usuarios,colaboradores,nomina,notificaciones,solicitudes,permisos,vacaciones,incapacidades

# Correo: console (escribe .eml en data/correos y muestra el enlace en consola) | smtp
MAIL_TRANSPORT=console
MAIL_FROM="Talento Humano <no-responder@example.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Almacenamiento de archivos subidos: local (fuera de la carpeta pública)
STORAGE_DRIVER=local
STORAGE_DIR=./uploads

# Proxy inverso (Nginx, hosting): número de saltos de proxy de confianza
TRUST_PROXY=0

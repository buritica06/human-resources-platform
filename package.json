{
  "name": "plataforma-th",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma de Talento Humano – Masinero Compraventas",
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "node --watch-path=./src --watch-preserve-output src/server.js",
    "start": "node src/server.js",
    "migrate": "node scripts/migrate.js",
    "seed": "node scripts/seed.js",
    "setup": "node scripts/migrate.js && node scripts/seed.js",
    "crear-admin": "node scripts/crear-admin.js",
    "fixtures": "node scripts/generar-excel-ficticio.js && node scripts/generar-nomina-ficticia.js",
    "backup": "node scripts/backup-db.js",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "lint": "eslint src scripts tests seeds"
  },
  "dependencies": {
    "argon2": "^0.45.2",
    "better-sqlite3": "^13.2.0",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "knex": "^3.3.0",
    "multer": "^2.5.0",
    "nodemailer": "^10.6.1",
    "pdfkit": "^0.21.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "supertest": "^7.3.2"
  }
}
